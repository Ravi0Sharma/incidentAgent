# Copy these values into the local untracked .env only after creating an API
# key. Never commit or paste the real key into source, reports, or chat.

OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-in-local-dotenv-only

# Start with one bounded model call per selected case. Tool calls stay off until
# the no-tool baseline is measured and cost/usage metadata is persisted.
USE_TOOL_CALLING=false
MAX_TOOL_CALLS=0
MAX_TOKENS_INTERPRETATION=600
LLM_TIMEOUT_SECONDS=45
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_OPEN_SECONDS=30
LOCAL_LLM_FORMAT_FALLBACK=false
SKIP_LLM=false
