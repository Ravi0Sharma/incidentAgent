ENVIRONMENT=shadow
SERVICE_VERSION=<immutable-git-sha>
DEPLOYMENT_TENANT_ID=arcvial
PROCESS_ROLE=api
SECRETS_PROVIDER=vault
PUBLIC_BASE_URL=https://incident-shadow.example.com
EGRESS_ALLOWED_HOSTS=incident-shadow.example.com,identity.example.com,api.openai.com,logs.example.com,metrics.example.com,api.github.com,otel.example.com,*.amazonaws.com

CHECKPOINTER=mysql
MYSQL_HOST=<private-mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=incident_agent
MYSQL_API_USER=<api-runtime-user>
MYSQL_API_PASSWORD=<secret-reference>
MYSQL_WORKER_USER=<worker-runtime-user>
MYSQL_WORKER_PASSWORD=<secret-reference>
# Use this only in a one-off migration release job; never in API or worker.
MYSQL_MIGRATOR_USER=<schema-migrator-user>
MYSQL_MIGRATOR_PASSWORD=<secret-reference>
MYSQL_POOL_SIZE=8
MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=5
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_WRITE_TIMEOUT_SECONDS=30
MYSQL_SSL_ENABLED=true
MYSQL_SSL_CA=/run/secrets/mysql-ca.pem
MYSQL_SSL_VERIFY_IDENTITY=true
RUNTIME_SCHEMA_DDL_ENABLED=false

API_DRAIN_JOBS=false
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_STALE_SECONDS=15
MIN_ACTIVE_WORKERS=2
MAX_PENDING_JOBS=1000

INTAKE_ENABLED=true
WORKER_ENABLED=true
CONNECTORS_ENABLED=true
MODEL_ENABLED=true
PUBLISH_EXTERNAL=false

# Optional: permit webhook traffic only from the alert gateway address range.
# When using a reverse proxy, list its direct address range here before the
# app will honour X-Forwarded-For for source filtering and caller rate limits.
# WEBHOOK_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# WEBHOOK_ALLOWED_SOURCE_CIDRS=198.51.100.0/24

REVIEW_AUTH_MODE=oidc
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=incident-agent
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_METADATA_URL=https://identity.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=incident-agent
OIDC_CLIENT_SECRET=<secret-reference>
OIDC_REDIRECT_URI=https://incident-shadow.example.com/auth/callback
OIDC_ROLE_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
OIDC_VIEWER_ROLES=incident-viewer,incident-reviewer,incident-admin
OIDC_DECISION_ROLES=incident-reviewer,incident-admin
OIDC_OPERATOR_ROLES=incident-operator,incident-admin
REVIEW_CSRF_SECRET=<secret-reference-32-plus-chars>
REVIEW_SESSION_SECRET=<different-secret-reference-32-plus-chars>
REDACTION_SALT=<secret-reference>
PII_REDACTION_ENABLED=true
CORS_ORIGINS=https://incident-shadow.example.com

OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces
METRICS_BEARER_TOKEN=<secret-reference-32-plus-chars>
CANARY_SHARED_SECRET=<different-secret-reference-32-plus-chars>
WORKER_METRICS_PORT=9100
CANARY_MAX_AGE_SECONDS=300
