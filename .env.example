# ==============================================================
# LLM
# ==============================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=replace-with-local-api-key
# Local-only temporary allowance for the current hardware-constrained
# LM Studio model. Do not use this timeout for hosted or production LLMs.
LLM_TIMEOUT_SECONDS=660
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_OPEN_SECONDS=30
# Incident-wide hard limits. Every real provider attempt, including retries,
# is charged before it starts. A zero USD cap disables only the local currency
# gate; shadow/production require a positive cap and configured token prices.
LLM_MAX_CALLS_PER_INCIDENT=12
LLM_MAX_INPUT_TOKENS_PER_INCIDENT=60000
LLM_MAX_OUTPUT_TOKENS_PER_INCIDENT=12000
LLM_MAX_TOTAL_TOKENS_PER_INCIDENT=72000
LLM_MAX_COST_USD_PER_INCIDENT=0
LLM_INPUT_USD_PER_MILLION_TOKENS=0
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0
# Local zero values disable the currency gate. For hosted gpt-5.6-luna,
# configure a positive per-incident cap and the current official model prices.
# Prices verified 2026-08-09: input 0.20 USD/MTok, output 1.20 USD/MTok.
# Recheck https://developers.openai.com/api/docs/models before deployment.
# Temporary local-only tolerance for models that ground the answer but miss
# the exact review Markdown headings. It is disabled outside ENVIRONMENT=local.
LOCAL_LLM_FORMAT_FALLBACK=true
SERVICE_VERSION=local

MAX_TOKENS_INTERPRETATION=1200
MAX_TOKENS_POSTMORTEM=1800

# ==============================================================
# Telemetry source selection
# ==============================================================
# Keep these defaults for local Loki/Prometheus evaluation. For the first AWS
# integration, set both to cloudwatch and point at a private copy of the
# example source map. AWS credentials must come from the runtime IAM role.
LOG_SOURCE=loki
METRIC_SOURCE=prometheus
# CLOUDWATCH_REGION=eu-north-1
# CLOUDWATCH_SOURCE_MAP_PATH=config/cloudwatch_sources.yaml
CLOUDWATCH_LOG_QUERY_LIMIT=5000
CLOUDWATCH_LOG_POLL_ATTEMPTS=12
CLOUDWATCH_LOG_POLL_INTERVAL_SECONDS=0.5
CLOUDWATCH_METRIC_PAGE_LIMIT=5

# ==============================================================
# Loki (leave blank to use mock)
# ==============================================================
# LOKI_URL=https://logs-prod-us-central1.grafana.net
# LOKI_USER=123456
# LOKI_API_KEY=glc_xxxxxxxxxxxx

LOG_LOOKBACK_MINUTES=15
# The alert timestamp anchors the actual investigation window. The legacy
# lookback setting remains available for callers that do not provide a window.
INCIDENT_WINDOW_PRE_MINUTES=10
INCIDENT_WINDOW_MAX_MINUTES=120
# Retrieval is selected across time and high-signal shapes, never as a simple
# last-N window. The hard cap bounds source work and durable incident state.
LOG_QUERY_LIMIT=5000
INITIAL_LOG_QUERY_LIMIT=500
SEV1_LOG_QUERY_LIMIT=3000
SEV2_LOG_QUERY_LIMIT=1500
LOG_TOOL_QUERY_LIMIT=50
MAX_SCOPE_SERVICES=12

# ==============================================================
# Prometheus (leave blank to use mock)
# ==============================================================
# PROMETHEUS_URL=https://prometheus-prod-us-central1.grafana.net
# PROMETHEUS_USER=123456
# PROMETHEUS_API_KEY=glc_xxxxxxxxxxxx

METRIC_LOOKBACK_MINUTES=15

# ==============================================================
# GitHub (leave blank to use mock)
# ==============================================================
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_REPO=myorg/myrepo

DEPLOY_LOOKBACK_HOURS=48

# ==============================================================
# Slack (leave blank to use mock)
# ==============================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxx
SLACK_CHANNEL=#incidents

# ==============================================================
# Durable MySQL 8+ checkpointer
# ==============================================================
CHECKPOINTER=mysql
MAX_STORED_LOG_BYTES=5242880
MAX_COMPRESSED_LOG_BYTES=1048576
MYSQL_TABLE=langgraph_checkpoints
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=incident_agent
MYSQL_USER=root
# MYSQL_PASSWORD=replace-with-local-password
# A production/shadow migration job uses PROCESS_ROLE=migrator with a separate
# DDL-capable identity. API and worker database users must not have DDL grants.
# MYSQL_MIGRATOR_USER=incident_agent_migrator
# MYSQL_MIGRATOR_PASSWORD=replace-with-migrator-password

# Bounded retries and an in-process source circuit breaker
SOURCE_RETRY_ATTEMPTS=2
SOURCE_RETRY_BACKOFF_SECONDS=0.25
SOURCE_CIRCUIT_OPEN_SECONDS=30

# Per-source request policies override the global SOURCE_* defaults.
LOKI_TIMEOUT_SECONDS=30
PROMETHEUS_TIMEOUT_SECONDS=30
CLOUDWATCH_LOGS_TIMEOUT_SECONDS=30
CLOUDWATCH_METRICS_TIMEOUT_SECONDS=30
GITHUB_TIMEOUT_SECONDS=15
SLACK_TIMEOUT_SECONDS=15
# Optional per-source overrides: LOKI_RETRY_ATTEMPTS,
# LOKI_RETRY_BACKOFF_SECONDS, LOKI_CIRCUIT_OPEN_SECONDS (and equivalents for
# PROMETHEUS, CLOUDWATCH_LOGS, CLOUDWATCH_METRICS, GITHUB, and SLACK).

# Metrics can escalate the provisional severity after collection.
SEV1_ERROR_RATE_THRESHOLD=0.50
SEV2_ERROR_RATE_THRESHOLD=0.10

# Redact common secrets and pseudonymize personal identifiers before state,
# prompts, local reports and external publication.
PII_REDACTION_ENABLED=true
REDACTION_SALT=replace-with-a-stable-secret-per-environment

# ==============================================================
# Observability — Arize Phoenix (open-source, self-hosted)
#
# Start the local UI in a separate terminal:
#     .venv/bin/phoenix serve
# Then open http://127.0.0.1:6006
#
# Every LangGraph node + every OpenAI call becomes a
# clickable span with prompt, response, tokens and latency.
# All data stays on your machine.
# ==============================================================
# PHOENIX_ENABLED=true
# Prompt, response and graph-state content is hidden by default. Set this to
# false only for an explicitly approved, synthetic local debugging session.
# PHOENIX_COMPACT_TRACES=true
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# PHOENIX_PROJECT_NAME=incident-agent

# ==============================================================
# General
# ==============================================================
ENVIRONMENT=local
SUPPORTED_INCIDENT_ENVIRONMENTS=local,development,staging,shadow,production
# Runtime modes: local may use mocks/Phoenix. Shadow and production require
# authenticated HTTPS sources, hosted model access, MySQL, redaction and
# explicit CORS; both force external publishing off until the outbox exists.
# Alerts without environment labels use this local-development default.
DEFAULT_ALERT_ENVIRONMENT=local

# In shadow/production, callers must send X-Incident-Timestamp,
# X-Incident-Nonce and X-Incident-Signature. The HMAC covers
# timestamp + "." + nonce + "." + raw request body.
# WEBHOOK_SHARED_SECRET=replace-with-a-webhook-secret
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# Optional source-address filter. X-Forwarded-For is accepted only when the
# direct peer belongs to WEBHOOK_TRUSTED_PROXY_CIDRS; otherwise rate limiting
# uses the direct client address. Do not use an arbitrary client-ID header.
# WEBHOOK_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# WEBHOOK_ALLOWED_SOURCE_CIDRS=198.51.100.0/24
# Local only. Shadow/production require REVIEW_AUTH_MODE=oidc instead.
# REVIEW_USERNAME=incident-reviewer
# REVIEW_PASSWORD=replace-with-a-strong-password
# REVIEW_AUTH_MODE=oidc
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=incident-agent
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_METADATA_URL=https://identity.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=incident-agent
# OIDC_CLIENT_SECRET=replace-from-secret-manager
# OIDC_REDIRECT_URI=https://incident.example.com/auth/callback
# OIDC_ROLE_CLAIM=roles
# OIDC_VIEWER_ROLES=incident-viewer,incident-reviewer,incident-admin
# OIDC_DECISION_ROLES=incident-reviewer,incident-admin
# OIDC_OPERATOR_ROLES=incident-operator,incident-admin
# REVIEW_CSRF_SECRET=replace-with-at-least-32-random-characters
# REVIEW_SESSION_SECRET=replace-with-a-different-32-character-random-secret
REVIEW_SESSION_MAX_AGE_SECONDS=28800
REVIEW_CSRF_TTL_SECONDS=900
# CORS_ORIGINS=https://incident.example.com

# Webhook intake limits. Requests that exceed body/batch limits are rejected
# before analysis begins.
MAX_WEBHOOK_BODY_BYTES=262144
WEBHOOK_GLOBAL_RATE_LIMIT=120
WEBHOOK_CALLER_RATE_LIMIT=60
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_WORKER_BATCH_SIZE=10
# Set false whenever API and worker run as separate services. Shadow and
# production reject true. Start the worker with scripts/run_worker.py.
API_DRAIN_JOBS=true
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_STALE_SECONDS=15
MAX_PENDING_JOBS=1000
# Matching fingerprint/service/tenant alerts share one incident time bucket.
# A short sliding debounce updates the pending job with the newest event.
INCIDENT_BUCKET_SECONDS=300
INCIDENT_COALESCE_SECONDS=5
INCIDENT_COALESCE_MAX_SECONDS=30
ANALYSIS_CODE_VERSION=incident-agent/v1
PROMPT_VERSION=prompts/v1
MAX_ALERTS_PER_REQUEST=50
MAX_ALERT_LABELS=50
MAX_ALERT_ANNOTATIONS=50
MAX_ALERT_FIELD_LENGTH=4096

# Local HTML drafts are always produced. Leave this false until review and
# external destinations are intentionally configured.
PUBLISH_EXTERNAL=false
